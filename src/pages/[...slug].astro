---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageCards from '../components/PageCards.astro';
import HubListings from '../components/HubListings.astro';
import ReadingGuides from '../components/ReadingGuides.astro';
import DepartmentLinks from '../components/DepartmentLinks.astro';
import departmentLinks from '../data/department-links.json';
import documents from '../data/documents.json';
import site from '../data/site.json';
import { getPages, pageHref, pageLabel } from '../lib/pages';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((page) => ({ params: { slug: page.data.slug }, props: { page, pages } }));
}
interface Props { page: CollectionEntry<'pages'>; pages: CollectionEntry<'pages'>[]; }
const { page, pages } = Astro.props;
const { data } = page;
const resolve = (ids: string[]) => ids.map((id) => {
  const record = pages.find((entry) => entry.id === id);
  if (!record) throw new Error(`${page.id}: missing record ${id}`);
  return record;
});
const locations = resolve(data.location_ids);
const related = resolve([...new Set([...data.related_ids, ...data.location_ids, ...data.service_ids])]);
const pageDocuments = documents.filter(({ parent_id }) => parent_id === page.id);
const { Content } = await render(page);
const isHub = data.content_type === 'hub';
const isNews = data.content_type === 'news';
const listingsFirst = site.navigation.some(({ slug }) => slug === data.slug);
const guideFirst = page.id === 'resource-cardiology-visit';
const isUniversityHospital = page.id === 'location-university-hospital';
const heading = pageLabel(data.slug, data.title);
const relatedCards = isUniversityHospital ? related.filter(({ data }) => data.content_type === 'service') : related;
const linksByDepartment: Partial<Record<string, { title: string; ids: string[]; description?: string }[]>> = departmentLinks;
const departmentGroups = data.content_type === 'service' ? linksByDepartment[page.id] : undefined;
if (data.content_type === 'service' && !departmentGroups?.length) throw new Error(`Missing reader links for ${page.id}`);
const formatDate = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const parentSlug = data.slug.startsWith('care/') ? 'care' : data.slug.split('/').length > 1 ? data.slug.split('/')[0] : '';
const parentLabels: Record<string, string> = { research: 'Research', community: 'Community', news: 'News' };
const parentLabel = pageLabel(parentSlug, parentLabels[parentSlug]);
const groups = [
  { title: 'University sections', type: 'hub' },
  { title: 'Clinical departments', type: 'service' },
  { title: 'Provider profiles', type: 'provider' },
  { title: 'Patient resources', type: 'resource' },
  { title: 'Campus buildings', type: 'location' },
  { title: 'Academic programs', type: 'program' },
  { title: 'Research groups and information', type: 'research' },
  { title: 'Community programs', type: 'community' },
  { title: 'Historical notices', type: 'news' },
];
const hubGroups = isHub ? groups.flatMap(({ title, type }) => {
  const pages = related.filter(({ data }) => data.content_type === type);
  if (type === 'news') pages.sort((a, b) => b.data.published_date.localeCompare(a.data.published_date));
  return pages.length ? [{ title, pages }] : [];
}) : [];
---
<SiteLayout page={data} locationNames={locations.map(({ data }) => data.title)}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol><li><a href={pageHref()}>Home</a></li>{parentLabel && <li><a href={pageHref(parentSlug)}>{parentLabel}</a></li>}<li aria-current="page">{heading}</li></ol>
    </nav>
    <header class="page-heading">
      <h1>{heading}</h1>
      {isNews && <time class="article-date" datetime={data.published_date}>{formatDate.format(new Date(data.published_date))}</time>}
    </header>
    <article class="article-content" aria-label={heading}>
      {departmentGroups && <DepartmentLinks groups={departmentGroups} pages={pages} />}
      {listingsFirst && <HubListings groups={hubGroups} directory />}
      {guideFirst && <ReadingGuides documents={pageDocuments} featured />}
      {isUniversityHospital && <p class="campus-shortcut"><a href={pageHref('news/teaching-library-opening')}>Read the anatomy reading room opening notice</a></p>}
      <div class="search-body"><p class="lead">{data.summary}</p><Content /></div>
      {!guideFirst && <ReadingGuides documents={pageDocuments} />}
      {isHub ? !listingsFirst && <HubListings groups={hubGroups} /> :
        !departmentGroups && relatedCards.length > 0 &&
          <section class="related-section" aria-labelledby="related-heading">
            <h2 id="related-heading">{isUniversityHospital ? 'Teaching wing departments' : 'Related information'}</h2>
            <PageCards pages={relatedCards} />
          </section>}
    </article>
  </div>
</SiteLayout>
