---
import site from '../data/site.json';
import SiteLayout from '../layouts/SiteLayout.astro';
import { pageSchema } from '../lib/content';
import { pageHref } from '../lib/pages';

const page = pageSchema.parse(site.home);
const campus = [
  { slug: 'locations/university-hospital', title: 'Inside University Hospital', description: 'Find the departments in the teaching wing and the anatomy reading room beside the hospital.' },
  { slug: 'education/nursing', title: 'Nursing Studies and course materials', description: 'See what students do in the simulation room and open the Nursing Classroom Materials PDF.' },
  { slug: 'news/teaching-library-opening', title: 'Anatomy reading room opening', description: 'Read the library’s opening notice and see which books, diagrams, and model catalogs moved into the new room.' },
];
---
<SiteLayout page={page}>
  <section class="home-directory" aria-labelledby="home-title">
    <div class="container">
      <div class="search-body">
        <h1 id="home-title">{page.title}</h1>
        <p>{page.summary}</p>
      </div>
      <form class="directory-search" role="search" action={pageHref('search')} method="get">
        <input type="search" name="q" aria-label="Search the website" placeholder="e.g. nursing courses" required />
        <button type="submit">Search</button>
      </form>
    </div>
  </section>
  <section class="container home-campus" aria-labelledby="campus-heading">
    <h2 id="campus-heading">The hospital campus</h2>
    <ul class="campus-list">
      {campus.map(({ slug, title, description }) => (
        <li>
          <h3><a href={pageHref(slug)}>{title}</a></h3>
          <p>{description}</p>
        </li>
      ))}
    </ul>
  </section>
  <nav class="container home-sections" aria-label="More university sections">
    <a href={pageHref('research')}>Research</a>
    <a href={pageHref('community')}>Community programs</a>
    <a href={pageHref('news')}>News archive</a>
  </nav>
</SiteLayout>
