---
import type { CollectionEntry } from 'astro:content';
import { pageHref, pageLabel } from '../lib/pages';

interface Props { pages: CollectionEntry<'pages'>[]; }
const { pages } = Astro.props;
---
<ul class="card-grid">
  {pages.map(({ data }) => (
    <li class="content-card">
      <h3><a href={pageHref(data.slug)}>{pageLabel(data.slug, data.title)}</a></h3>
      <p>{data.summary}</p>
    </li>
  ))}
</ul>
